# Cloudflare R2（scripts/publish-images.mjs からのみ使用。クライアントには公開されません）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-assets
# 通常は不要。S3 互換ストレージやテスト用にエンドポイントを上書きする場合のみ設定
R2_ENDPOINT=

# 最適化済み画像の公開URL（Worker の workers.dev URL、または独自ドメイン）
# 例: https://portfolio-assets.<account>.workers.dev
# 未設定の場合は public/images/optimized から配信（ローカル開発用フォールバック）
NEXT_PUBLIC_IMAGE_BASE_URL=
